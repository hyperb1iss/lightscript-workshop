{
  "name": "@lightscript/dev",
  "version": "1.0.0",
  "description": "Development tools, preview server, and build pipeline for LightScript effects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "bin": {
    "lightscript-build": "./scripts/build.js"
  },
  "files": [
    "dist",
    "scripts",
    "plugins"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lightscript/core": "workspace:*",
    "glob": "^13.0.0"
  },
  "peerDependencies": {
    "preact": ">=10.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    },
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^24.10.1",
    "preact": "^10.27.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-glsl": "^1.5.5"
  },
  "keywords": [
    "lightscript",
    "signalrgb",
    "development",
    "vite",
    "preview"
  ],
  "author": "Stefanie Jane <stef@hyperbliss.tech>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperb1iss/lightscript-workshop",
    "directory": "packages/dev"
  }
}
