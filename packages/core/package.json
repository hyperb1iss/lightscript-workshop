{
  "name": "@lightscript/core",
  "version": "1.0.0",
  "description": "TypeScript API for creating SignalRGB lighting effects with decorators and WebGL",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shaders": {
      "types": "./dist/shaders.d.ts",
      "import": "./dist/shaders.js"
    },
    "./shaders/*": "./src/shaders/*"
  },
  "files": [
    "dist",
    "src/shaders"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "^0.181.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "signalrgb",
    "rgb",
    "lighting",
    "effects",
    "webgl",
    "shader",
    "typescript",
    "decorators"
  ],
  "author": "Stefanie Jane <stef@hyperbliss.tech>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperb1iss/lightscript-workshop",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hyperb1iss/lightscript-workshop/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/hyperb1iss/lightscript-workshop/issues"
  }
}
