{
  "name": "lightscript-workshop",
  "version": "0.9.0",
  "description": "Modern framework for creating RGB lighting effects for SignalRGB",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:with-effect": "EFFECT=your-effect-id vite",
    "build": "node scripts/build.js",
    "build:analyze": "ANALYZE_BUNDLE=true node scripts/build.js",
    "build:debug": "NO_MINIFY=true node scripts/build.js",
    "build:single": "tsc && vite build",
    "preview": "vite preview",
    "format": "npm run format:code && npm run format:content",
    "format:code": "biome format --write .",
    "format:content": "prettier --write \"**/*.{md,mdx,markdown,yml,yaml,json}\"",
    "format:check": "npm run format:code:check && npm run format:content:check",
    "format:code:check": "biome format .",
    "format:content:check": "prettier --check \"**/*.{md,mdx,markdown,yml,yaml,json}\"",
    "format:glsl": "prettier --write \"**/*.{glsl,vert,frag}\"",
    "format:glsl:check": "prettier --check \"**/*.{glsl,vert,frag}\"",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "lint:glsl": "node scripts/glsl-lint.js",
    "lint:glsl:fix": "npm run format:glsl && npm run lint:glsl",
    "typecheck": "tsc --noEmit",
    "prepare-release": "npm run format && npm run lint:fix && npm run lint:glsl:fix && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bundle:size": "node scripts/analyze-bundle.js",
    "dev:tools": "node scripts/dev-tools.js",
    "dev:fast": "vite --host 0.0.0.0 --port 4096"
  },
  "keywords": [
    "webgl",
    "shader",
    "signalrgb",
    "lightscript",
    "threejs",
    "rgb",
    "lighting",
    "effects",
    "typescript"
  ],
  "author": "Stefanie Jane <stef@hyperbliss.tech>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperb1iss/lightscript-workshop"
  },
  "homepage": "https://github.com/hyperb1iss/lightscript-workshop",
  "bugs": {
    "url": "https://github.com/hyperb1iss/lightscript-workshop/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@preact/preset-vite": "2.10.2",
    "@types/node": "24.2.1",
    "@types/three": "0.179.0",
    "@vitejs/plugin-react-swc": "4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@webgpu/glslang": "^0.0.15",
    "canvas": "^3.1.0",
    "glob": "^11.0.3",
    "glslang-validator-prebuilt-predownloaded": "^0.0.2",
    "glslify": "^7.1.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-glsl": "^0.2.2",
    "prettier-plugin-uppercase-doctype": "^1.0.0",
    "rollup-plugin-analyzer": "^4.0.0",
    "terser": "5.43.1",
    "typescript": "5.9.2",
    "vite": "7.1.1",
    "vite-bundle-analyzer": "1.2.1",
    "vite-plugin-glsl": "^1.5.1",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "preact": "10.27.0",
    "reflect-metadata": "^0.2.2",
    "three": "0.179.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
